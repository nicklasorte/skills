{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable review issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "status",
    "severity",
    "finding",
    "source_refs"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "pending",
        "superseded"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "consequence": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_correction": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition_rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
